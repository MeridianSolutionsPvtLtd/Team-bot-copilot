TENANT_ID=your-tenant-id
CLIENT_ID=your-app-client-id
CLIENT_SECRET=your-app-client-secret
CLIENT_STATE=replace-with-random-secret

WEBHOOK_PUBLIC_URL=https://your-app-name.azurewebsites.net/graph/webhook
LIFECYCLE_NOTIFICATION_URL=https://your-app-name.azurewebsites.net/graph/webhook

AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Azure Communication Services Email
ACS_CONNECTION_STRING=endpoint=https://<resource>.communication.azure.com/;accesskey=<key>
ACS_EMAIL_FROM=DoNotReply@<your-verified-domain>

# Storage backend: onedrive (active) | cosmos (rollback — uncomment Cosmos code in app/db.py)
STORAGE_BACKEND=onedrive

# OneDrive storage (Graph) — per-user mode:
# each internal attendee gets the summary in THEIR OneDrive under ONEDRIVE_FOLDER.
# App needs Application permission: Files.ReadWrite.All (+ User.Read.All helpful) + admin consent
# ONEDRIVE_OWNER_UPN is optional fallback only (processed marker if organizer id missing)
ONEDRIVE_OWNER_UPN=
ONEDRIVE_FOLDER=MeetingIntelligence

# Azure Cosmos DB for MongoDB — kept for rollback only (not used while STORAGE_BACKEND=onedrive)
# COSMOS_CONNECTION_STRING=mongodb://<user>:<password>@<account>.mongo.cosmos.azure.com:10255/?ssl=true&replicaSet=globaldb&retrywrites=false&maxIdleTimeMS=120000&appName=@<account>@
# COSMOS_DATABASE=meeting-intelligence
# COSMOS_CONTAINER=transcripts

# Copilot Studio calls these APIs with this key (header: X-API-Key)
# Also pass the signed-in user's email as header X-User-Email (= System.User.Email)
COPILOT_API_KEY=replace-with-random-api-key
# Optional: comma-separated emails that can view any meeting (managers/admins)
COPILOT_ADMIN_EMAILS=admin@yourcompany.com

# Timezone used for displayed timestamps (storage stays UTC)
DISPLAY_TIMEZONE=Asia/Kolkata
