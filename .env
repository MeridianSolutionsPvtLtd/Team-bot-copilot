TENANT_ID=your-tenant-id
CLIENT_ID=your-app-client-id
CLIENT_SECRET=your-app-client-secret
CLIENT_STATE=replace-with-random-secret

WEBHOOK_PUBLIC_URL=https://your-domain.com/graph/webhook
LIFECYCLE_NOTIFICATION_URL=https://your-domain.com/graph/webhook

AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-02-15-preview

MAIL_FROM=meetingbot@yourcompany.com
SQLITE_PATH=./meeting_agent.db

# Copilot Studio calls these APIs with this key (header: X-API-Key)
COPILOT_API_KEY=replace-with-random-api-key
